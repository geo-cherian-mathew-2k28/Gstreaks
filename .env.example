# GeoStreak Environment Configuration

# GitHub Personal Access Token (PAT)
# Required for server-side GitHub GraphQL API requests with 5,000 req/hr rate limits.
# Can be a classic token (no scopes needed for public user data) or fine-grained token.
# You can also supply multiple tokens separated by commas for round-robin load balancing.
GITHUB_TOKEN=your_github_personal_access_token_here
# GITHUB_TOKENS=token_1,token_2,token_3

# Base URL of the deployed application (used for README snippet generation)
NEXT_PUBLIC_APP_URL=https://geostreak.vercel.app

# Optional: Upstash Redis (For distributed caching across serverless instances)
# If not configured, GeoStreak seamlessly uses high-performance in-memory LRU caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Supabase (For persistent community themes or accounts if extended)
SUPABASE_URL=
SUPABASE_ANON_KEY=
